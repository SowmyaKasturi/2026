Source :  Leet code
Number: 3657 Find loyal customers
Complexity: Medium
SELECT customer_id
FROM customer_transactions
GROUP BY customer_id
HAVING
  SUM(CASE WHEN transaction_type = 'purchase' THEN 1 ELSE 0 END) >= 3
  AND MAX(transaction_date) - MIN(transaction_date) >= 30
  AND
  SUM(CASE WHEN transaction_type = 'refund' THEN 1 ELSE 0 END) * 1.0 / COUNT(*) < 0.20
  order by customer_id
